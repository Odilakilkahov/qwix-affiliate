---
import Base from '../../layouts/Base.astro'; import { published } from '../../lib/content'; import { base } from '../../config/site'; const entries=await published('reviews');
---
<Base title="Reviews"><section class="shell listing"><p>Reviews</p><h1>Tools, with the trade-offs included.</h1>{entries.length ? <div>{entries.map(entry => <article><a href={`${base}reviews/${entry.id}/`}><h2>{entry.data.title}</h2><p>{entry.data.description}</p><span>Read review →</span></a></article>)}</div> : <p>No published reviews yet.</p>}</section></Base>
<style>.listing{padding:5rem 0;max-width:850px}.listing>p:first-child{color:var(--plum);font-weight:700}.listing h1{font-size:clamp(2.6rem,6vw,4.8rem);margin:.5rem 0 4rem}.listing article{border-top:1px solid var(--line);padding:1.7rem 0}.listing article a{text-decoration:none}.listing h2{font-size:1.6rem;margin:0}.listing p{color:var(--muted);line-height:1.55}.listing span{color:var(--plum);font-weight:700}</style>
