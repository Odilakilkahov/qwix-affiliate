---
import { getCollection, render } from 'astro:content'; import Base from '../../layouts/Base.astro'; import Disclosure from '../../components/Disclosure.astro'; import Sources from '../../components/Sources.astro'; import { base } from '../../config/site';
export async function getStaticPaths(){ return (await getCollection('reviews')).filter(x=>!x.data.draft).map(x=>({params:{slug:x.id},props:{entry:x}})); }
const { entry } = Astro.props; const { Content }=await render(entry); const d=entry.data;
const jsonLd={ '@context':'https://schema.org', '@type':'Review', name:d.title, description:d.description, itemReviewed:{'@type':'SoftwareApplication',name:d.product}, dateModified:d.updatedAt.toISOString() };
---
<Base title={d.title} description={d.description} jsonLd={jsonLd}><article class="shell article">{d.affiliate && <Disclosure />}<p class="label">Review · updated {d.updatedAt.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</p><h1>{d.title}</h1><p class="dek">{d.description}</p><section class="verdict"><h2>Bottom line</h2><p>{d.verdict}</p></section><Content /><div class="columns"><section><h2>What works</h2><ul>{d.prosList.map(item=><li>{item}</li>)}</ul></section><section><h2>Trade-offs</h2><ul>{d.consList.map(item=><li>{item}</li>)}</ul></section></div><section><h2>Who it is not for</h2><ul>{d.notForList.map(item=><li>{item}</li>)}</ul></section>{d.affiliate && <p><a class="button" href={`${base}go/${d.affiliate}/`} rel="sponsored nofollow noopener">Visit {d.product}</a></p>}<Sources sources={d.sources} checkedAt={d.pricingCheckedAt}/></article></Base>
<style>.article{padding:4rem 0;max-width:850px}.article h1{font-size:clamp(2.5rem,6vw,4.7rem);margin:.5rem 0 1rem}.label{color:var(--plum);font-weight:700;font-size:.9rem}.dek{font-size:1.25rem;line-height:1.55;color:var(--muted);max-width:65ch}.verdict{border-top:2px solid var(--plum);margin:2.5rem 0;padding-top:1rem}.article :global(.prose),.article section{margin:2.5rem 0}.article li{margin:.5rem 0;line-height:1.5}.columns{display:grid;grid-template-columns:1fr 1fr;gap:2rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}@media(max-width:600px){.columns{grid-template-columns:1fr;gap:0}}</style>
