---
import Base from '../layouts/Base.astro'; import { published } from '../lib/content'; import { base } from '../config/site';
const [reviews, comparisons] = await Promise.all([published('reviews'), published('comparisons')]);
---
<Base><section class="shell hero"><p>For practical small teams</p><h1>Choose the software that earns its place.</h1><p>{`Independent comparisons and honest reviews for people building with less overhead.`}</p><a class="button" href={`${base}comparisons`}>Browse comparisons</a></section><section class="shell feed"><div><h2>Latest comparisons</h2>{comparisons.length ? comparisons.slice(0,3).map(x => <article><a href={`${base}comparisons/${x.id}/`}><h3>{x.data.title}</h3><p>{x.data.description}</p></a></article>) : <p>New comparisons are being prepared.</p>}</div><div><h2>Latest reviews</h2>{reviews.length ? reviews.slice(0,3).map(x => <article><a href={`${base}reviews/${x.id}/`}><h3>{x.data.title}</h3><p>{x.data.description}</p></a></article>) : <p>New reviews are being prepared.</p>}</div></section></Base>
<style>.hero{padding:clamp(4rem,12vw,9rem) 0 5rem;max-width:900px}.hero>p:first-child{color:var(--plum);font-weight:700}.hero h1{font-size:clamp(3rem,8vw,6rem);margin:.6rem 0 1.25rem}.hero>p:not(:first-child){max-width:54ch;color:var(--muted);font-size:1.2rem;line-height:1.6;margin-bottom:2rem}.feed{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,7rem)}.feed h2{font-size:1.8rem}.feed article{border-top:1px solid var(--line);padding:1.25rem 0}.feed article a{text-decoration:none}.feed h3{font-size:1.3rem;margin:0}.feed p{color:var(--muted);line-height:1.5}@media(max-width:650px){.feed{grid-template-columns:1fr}}</style>
