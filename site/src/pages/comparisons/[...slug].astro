---
import { getCollection, render } from 'astro:content'; import Base from '../../layouts/Base.astro'; import Disclosure from '../../components/Disclosure.astro'; import Sources from '../../components/Sources.astro'; import LiteYouTube from '../../components/LiteYouTube.astro';
export async function getStaticPaths(){return (await getCollection('comparisons')).filter(x=>!x.data.draft).map(x=>({params:{slug:x.id},props:{entry:x}}));}
const { entry }=Astro.props; const { Content }=await render(entry); const d=entry.data; const affiliated=d.affiliateSlugs.length>0 || d.products.some(x=>x.affiliate); const jsonLd={'@context':'https://schema.org','@type':'Article',headline:d.title,description:d.description,dateModified:d.updatedAt.toISOString()};
---
<Base title={d.title} description={d.description} canonical={new URL(`/comparisons/${entry.id}/`, Astro.url).href} jsonLd={jsonLd}><article class="shell article">{affiliated && <Disclosure />}<p class="label">Comparison · updated {d.updatedAt.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</p><h1>{d.title}</h1><p class="dek">{d.description}</p>{d.youtubeId && <LiteYouTube id={d.youtubeId} title={d.title}/>}<div class="table-wrap"><table><thead><tr><th>Tool</th>{d.products.map(x=><th>{x.name}</th>)}</tr></thead><tbody><tr><th>Price</th>{d.products.map(x=><td>{x.price}</td>)}</tr><tr><th>Best for</th>{d.products.map(x=><td>{x.bestFor}</td>)}</tr><tr><th>Limits</th>{d.products.map(x=><td>{x.limits}</td>)}</tr></tbody></table></div><section><h2>Best by use case</h2>{d.winnerByUseCase.map(x=><div class="winner"><strong>{x.useCase}: {x.winner}</strong><p>{x.reason}</p></div>)}</section><section><h2>Not for you if…</h2><div class="notfor">{d.products.map(x=><div><h3>{x.name}</h3><p>{x.notFor}</p>{x.affiliate && <a class="quiet-link" href={`/go/${x.affiliate}/`} rel="sponsored nofollow noopener">Visit {x.name}</a>}</div>)}</div></section><Content /><Sources sources={d.sources} checkedAt={d.pricingCheckedAt}/></article></Base>
<style>.article{padding:4rem 0;max-width:1000px}.article h1{font-size:clamp(2.5rem,6vw,4.7rem);margin:.5rem 0 1rem}.label{color:var(--plum);font-weight:700;font-size:.9rem}.dek{font-size:1.25rem;line-height:1.55;color:var(--muted);max-width:65ch;margin-bottom:2rem}.table-wrap{overflow-x:auto;margin:3rem 0;border:1px solid var(--line)}table{border-collapse:collapse;min-width:620px;width:100%;text-align:left}th,td{border-bottom:1px solid var(--line);padding:1rem;vertical-align:top;line-height:1.45}thead th{background:var(--surface)}tbody th{width:120px;color:var(--muted)}.article section{margin:3rem 0}.winner{border-top:1px solid var(--line);padding:1rem 0}.winner p,.notfor p{color:var(--muted);line-height:1.55}.notfor{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem}.notfor>div{border-top:2px solid var(--plum);padding-top:.75rem}.notfor h3{margin:0;font-size:1.2rem}</style>
