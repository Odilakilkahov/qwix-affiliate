---
const { sources, checkedAt } = Astro.props;
---
<section class="sources"><h2>Sources</h2><p>Pricing and limits checked <time datetime={checkedAt.toISOString()}>{checkedAt.toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' })}</time>.</p><ul>{sources.map((source: {label:string;url:string}) => <li><a href={source.url} rel="noopener noreferrer" target="_blank">{source.label}</a></li>)}</ul></section>
<style>.sources{border-top:1px solid var(--line);margin-top:3rem;padding-top:1.5rem}.sources h2{font-size:1.2rem}.sources p,.sources li{color:var(--muted)}.sources a{color:var(--plum)}</style>
